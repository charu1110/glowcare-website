{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8130",
        "--directory",
        "dashboard"
      ],
      "port": 8130
    },
    {
      "name": "preflux-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/charu/Preflux",
        "run",
        "dev:web"
      ],
      "port": 3000
    },
    {
      "name": "preflux-ml",
      "runtimeExecutable": "D:/charu/Preflux/services/ml/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "D:/charu/Preflux/services/ml",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "mausam-menu",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dev-server.mjs"
      ],
      "port": 8080
    }
  ]
}
